{
  "name": "@club/handlink-terminal",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "机械手控制终端：在 DSH Web UI 里直接操作 LG-603 灵巧手 + FOHEART HMax 数据手套（直连 SDK，不用开 MotionVenus）",
  "keywords": [
    "dsh-plugin",
    "cordis",
    "handlink",
    "robot",
    "lg-603",
    "motionvenus",
    "data-glove"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "python/**",
    "!python/site-packages",
    "data/**",
    "tools/**",
    "requirements.txt",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
